# ---- DJANGO ----
DJANGO_SECRET_KEY=change-me-generate-a-new-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- DATABASE (MariaDB) ----
DB_NAME=bug_tracker_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- AUTH / JWT COOKIES ----
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
# Refresh rotation never extends these server-enforced session limits.
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_MAX_HOURS=8
AUTH_COOKIE_NAME=zbt_access
REFRESH_COOKIE_NAME=zbt_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ---- ATTACHMENTS ----
ATTACHMENT_MAX_SIZE_MB=10

# ---- MAIL INTAKE (IMAP) ----
# Feature toggle. With this false the rest of the application is unaffected.
MAIL_INTAKE_ENABLED=false
MAIL_INTAKE_PROVIDER=gmail
MAIL_INTAKE_EMAIL=itdesk@zigma.in
MAIL_INTAKE_IMAP_HOST=imap.gmail.com
MAIL_INTAKE_IMAP_PORT=993
MAIL_INTAKE_USE_SSL=true
MAIL_INTAKE_USERNAME=itdesk@zigma.in
# Google App Password (16 chars, no spaces) -- NEVER the real account password,
# and never committed. Generate at https://myaccount.google.com/apppasswords
MAIL_INTAKE_APP_PASSWORD=your-google-app-password
MAIL_INTAKE_FOLDER=Support
# Comma-separated. Empty means accept mail sent to any recipient.
MAIL_INTAKE_ALLOWED_RECIPIENTS=
MAIL_INTAKE_MAX_SIZE_MB=25
MAIL_INTAKE_MAX_ATTEMPTS=3
MAIL_INTAKE_BATCH_LIMIT=50
MAIL_INTAKE_SYSTEM_USERNAME=mail.intake

# ---- OUTBOUND MAIL (SMTP) ----
# Dev/test default prints mail to the console. Production must use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=itdesk@zigma.in
TICKET_ACK_ENABLED=true
# Set this to the requesters' reachable frontend origin in production.
PUBLIC_APP_URL=http://localhost:5173

# ---- CLASSIFICATION ----
CLASSIFY_AUTO_MIN_SCORE=80
CLASSIFY_REVIEW_MIN_SCORE=50
ACCESS_AUTO_CLASSIFY_MIN_SCORE=90
FUZZY_MATCH_MIN_SCORE=88
CLASSIFY_CONFLICT_MARGIN=15
CLASSIFY_SCORE_DECAY=0.5
CLASSIFY_BODY_FIELD_WEIGHT=0.6
CLASSIFY_BODY_CHAR_LIMIT=4000
CLASSIFY_MIN_FUZZY_PATTERN_LENGTH=5
MODULE_MAPPING_MIN_SCORE=60
MODULE_MAPPING_TIE_MARGIN=10
MAIL_DEFAULT_PRIORITY_CODE=MEDIUM
MAIL_DEFAULT_SEVERITY_CODE=MAJOR
# Phase 2 only: swap for an AI provider without touching intake or workflow code.
# CLASSIFICATION_PROVIDER=apps.classification.services.rule_classifier.RuleClassifier

# ---- CELERY / REDIS ----
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/2
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
PUBLIC_TRACK_CHAT_THROTTLE_RATE=30/min
CELERY_RESULT_BACKEND=
CELERY_TASK_ACKS_LATE=true
MAIL_INTAKE_POLL_SECONDS=30
CELERY_TASK_TIME_LIMIT=240
CELERY_TASK_SOFT_TIME_LIMIT=210

# ---- WHATSAPP INTAKE (Meta Cloud API) ----
# Phase 1 is RECEIVE ONLY. Leave WHATSAPP_INTAKE_ENABLED false until the webhook
# is registered in the Meta App Dashboard: with it false the endpoint 404s and
# no task does any work.
#
# NOTE: the official Cloud API carries 1:1 conversations only. It cannot read
# group messages -- there are no group webhook events and no endpoint for them.
#
# Webhook callback URL to register with Meta:
#   https://<your-public-host>/webhooks/whatsapp/
# Meta requires public HTTPS with a CA-signed certificate; localhost and
# self-signed certificates are rejected. Subscribe to the "messages" field.
WHATSAPP_INTAKE_ENABLED=false
WHATSAPP_API_VERSION=v21.0

# Any random string you choose; Meta echoes it back during the one-time
# subscription handshake. Must match what you type into the dashboard.
WHATSAPP_VERIFY_TOKEN=

# The Meta App Secret. This verifies X-Hub-Signature-256 and is the ENTIRE
# security boundary of the public webhook. Never commit a real value.
WHATSAPP_APP_SECRET=

# A permanent System User access token, used only to download media.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# Which company receives messages is read from
# CompanyMaster.support_whatsapp_number_id, so onboarding a company is a data
# change rather than a deploy. This fallback applies only while NO company has
# a number configured.
WHATSAPP_DEFAULT_COMPANY_CODE=ZIGMA

# TESTING ONLY. While set, only these numbers open tickets; everything else is
# stored and marked SENDER_NOT_ALLOWED. Comma-separated; +, spaces and dashes are
# ignored. Leave EMPTY in production to accept every sender. Clear this once the
# office CUG number is live.
WHATSAPP_ALLOWED_SENDERS=916379088711

WHATSAPP_POLL_SECONDS=20
WHATSAPP_BATCH_LIMIT=100
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_MEDIA_TIMEOUT=20
WHATSAPP_MEDIA_MAX_ATTEMPTS=3
WHATSAPP_MAX_PAYLOAD_BYTES=1048576
WHATSAPP_EVENT_RETENTION_DAYS=90
WHATSAPP_WEBHOOK_THROTTLE_RATE=240/min
WHATSAPP_INTAKE_SYSTEM_USERNAME=whatsapp.intake
